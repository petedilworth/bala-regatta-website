---
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/settings';
import { ordinal } from '../lib/archive';
import { absolute, href } from '../lib/url';

const settings = await getSettings();

const date = settings.nextRegattaDate;
const dateLabel = date
  ? date.toLocaleDateString('en-CA', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : undefined;

const edition = settings.nextRegattaEdition;

// Structured data so a search for the regatta can show its date as a rich
// result. Emitted only while the date is still ahead of us: asserting a past
// event as "scheduled" is the kind of thing Search Console warns about.
const upcoming = date && date.getTime() >= Date.now() - 24 * 60 * 60 * 1000;
const schema = upcoming
  ? {
      '@context': 'https://schema.org',
      '@type': 'SportsEvent',
      name: edition ? `${ordinal(edition)} Bala Regatta` : 'Bala Regatta',
      startDate: date.toISOString().slice(0, 10),
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Township Dock',
        address: { '@type': 'PostalAddress', addressLocality: 'Bala', addressRegion: 'ON', addressCountry: 'CA' },
      },
      organizer: { '@type': 'Organization', name: 'Bala Aquatic Association', email: settings.email },
      url: absolute('/'),
      image: absolute('/og-default.png'),
    }
  : undefined;
---

<Base title="Bala Regatta" schema={schema}>
  <section class="hero">
    <div class="wrap">
      {/* The logo is the h1: the page's one heading, with the name as its alt text. */}
      <h1 class="hero__wordmark">
        <img src={href('/logo.jpg')} alt="Bala Regatta" width="1000" height="600" fetchpriority="high" />
      </h1>
      <p class="hero__association">Bala Aquatic Association</p>

      {
        (dateLabel || edition) && (
          <p class="hero__date">
            {edition && <span>{ordinal(edition)} annual</span>}
            {edition && dateLabel && <span class="hero__sep"> &middot; </span>}
            {dateLabel && <span>{dateLabel}</span>}
          </p>
        )
      }
      <p class="hero__place">Bala, Muskoka</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .hero__wordmark {
    margin: 0 auto;
    max-width: 34rem;
  }

  .hero__wordmark img {
    width: 100%;
    height: auto;
  }

  .hero__association {
    font-size: var(--step-0);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: var(--space-2xs) 0 0;
    max-width: none;
  }

  .hero__date {
    font-family: var(--serif);
    font-size: var(--step-2);
    color: var(--navy);
    margin: var(--space-xl) 0 0;
    max-width: none;
  }

  /* Decorative only — sky blue is not readable as text on white. */
  .hero__sep {
    color: var(--sky);
  }

  .hero__place {
    color: var(--fg-muted);
    margin: var(--space-3xs) 0 0;
    max-width: none;
  }
</style>

---
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/settings';
import { ordinal } from '../lib/archive';

const settings = await getSettings();

const date = settings.nextRegattaDate;
const dateLabel = date
  ? date.toLocaleDateString('en-CA', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : undefined;

const edition = settings.nextRegattaEdition;
---

<Base title="Bala Regatta">
  <section class="hero">
    <div class="wrap">
      {/*
        Logo slot. The artwork has not been supplied as a file yet, so the
        wordmark is set in type here. Replace this block with the logo image —
        alt text "Bala Regatta" — and drop the .hero__wordmark rules.
      */}
      <p class="hero__wordmark">Bala Regatta</p>
      <p class="hero__association">Bala Aquatic Association</p>

      {
        (dateLabel || edition) && (
          <p class="hero__date">
            {edition && <span>{ordinal(edition)} annual</span>}
            {edition && dateLabel && <span class="hero__sep"> &middot; </span>}
            {dateLabel && <span>{dateLabel}</span>}
          </p>
        )
      }
      <p class="hero__place">Bala, Muskoka</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  /* Stand-in for the logo artwork. Remove with the wordmark block above. */
  .hero__wordmark {
    font-family: var(--serif);
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--navy);
    margin: 0;
    max-width: none;
  }

  .hero__association {
    font-size: var(--step-0);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: var(--space-2xs) 0 0;
    max-width: none;
  }

  .hero__date {
    font-family: var(--serif);
    font-size: var(--step-2);
    color: var(--navy);
    margin: var(--space-xl) 0 0;
    max-width: none;
  }

  /* Decorative only — sky blue is not readable as text on white. */
  .hero__sep {
    color: var(--sky);
  }

  .hero__place {
    color: var(--fg-muted);
    margin: var(--space-3xs) 0 0;
    max-width: none;
  }
</style>

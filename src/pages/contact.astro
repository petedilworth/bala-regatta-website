---
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/settings';
import { href } from '../lib/url';

const settings = await getSettings();
---

<Base title="Contact" description="How to reach the Bala Regatta committee.">
  <section class="section">
    <div class="wrap stack">
      <p class="eyebrow">Get in touch</p>
      <h1>Contact</h1>
      <p class="lede">
        The regatta is run by volunteers, so replies may take a few days — quicker in the weeks
        before the event than in the middle of winter.
      </p>

      {
        settings.email && (
          <p>
            <strong>Email:</strong> <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </p>
        )
      }

      {
        (settings.facebook || settings.instagram) && (
          <p>
            <strong>Social:</strong>{' '}
            {settings.facebook && <a href={settings.facebook}>Facebook</a>}
            {settings.facebook && settings.instagram && ' · '}
            {settings.instagram && <a href={settings.instagram}>Instagram</a>}
          </p>
        )
      }

      <h2>Where the regatta is held</h2>
      <p>
        Township Dock, Bala, Ontario — in the middle of the village, on the Moon River
        narrows.
      </p>

      <h2>Sponsorship and prizes</h2>
      <p>
        See the <a href={href('/sponsors')}>sponsors page</a>, or email us directly.
      </p>

      <h2>The archives</h2>
      <p>
        Corrections, missing years, old programmes in your cottage drawer — all very welcome.
        There is a <a href={href('/archives/corrections')}>separate page</a> about how to help
        with the archive, including how to ask for a name or photograph to be removed.
      </p>

      <aside class="todo">
        <p>
          <strong>Confirm before launch.</strong> The email address above is a placeholder in
          <code>src/content/settings/settings.yaml</code>. Note that if any address on the
          balaregatta.com domain is in real use, its MX records must survive the domain
          transfer or mail will stop.
        </p>
      </aside>
    </div>
  </section>
</Base>


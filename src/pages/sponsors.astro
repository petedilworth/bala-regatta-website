---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { href } from '../lib/url';

const all = (await getCollection('sponsors')).filter((s) => s.data.active);
const major = all.filter((s) => s.data.tier === 'major');
const supporting = all.filter((s) => s.data.tier === 'supporting');
const thanks = all.filter((s) => s.data.tier === 'thanks');
---

<Base
  title="Sponsors"
  description="The local businesses who support the Bala Regatta."
>
  <section class="section">
    <div class="wrap stack">
      <p class="eyebrow">With thanks</p>
      <h1>Sponsors</h1>
      <p class="lede">
        The regatta is free to enter and run entirely by volunteers. These businesses pay for
        the prizes and the day itself — please support them.
      </p>

      {
        major.length > 0 && (
          <>
            <h2>Sponsors</h2>
            <ul class="grid list-plain">
              {major.map((s) => (
                <li class="card">
                  <h3>{s.data.url ? <a href={s.data.url}>{s.data.name}</a> : s.data.name}</h3>
                  {s.data.phone && (
                    <p class="card__meta">
                      <a href={`tel:${s.data.phone.replace(/[^\d+]/g, '')}`}>{s.data.phone}</a>
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        supporting.length > 0 && (
          <>
            <h2>Supporting sponsors</h2>
            <ul class="grid list-plain">
              {supporting.map((s) => (
                <li class="card">
                  <h3>{s.data.url ? <a href={s.data.url}>{s.data.name}</a> : s.data.name}</h3>
                  {s.data.phone && <p class="card__meta">{s.data.phone}</p>}
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        thanks.length > 0 && (
          <>
            <h2>Special thanks</h2>
            <ul class="thanks-list list-plain">
              {thanks.map((s) => (
                <li>{s.data.url ? <a href={s.data.url}>{s.data.name}</a> : s.data.name}</li>
              ))}
            </ul>
          </>
        )
      }

      <h2>Sponsoring the regatta</h2>
      <p>
        If your business would like to sponsor an event or donate a prize, please
        <a href={href('/contact')}>get in touch</a>.
      </p>

      <aside class="todo">
        <p>
          <strong>Verify before launch.</strong> This list and its phone numbers were taken
          from the current site. Confirm each business is still sponsoring, and add website
          links and logos in <code>src/content/sponsors/sponsors.yaml</code>.
        </p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .thanks-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    max-width: var(--measure);
  }

  .thanks-list li::after {
    content: '·';
    margin-left: var(--space-s);
    color: var(--fg-muted);
  }

  .thanks-list li:last-child::after {
    content: '';
  }
</style>

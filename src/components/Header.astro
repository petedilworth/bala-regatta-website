---
import { href } from '../lib/url';

const nav = [
  { label: 'Schedule', path: '/schedule' },
  { label: 'Register', path: '/register' },
  { label: 'Archives', path: '/archives' },
  { label: 'Sponsors', path: '/sponsors' },
  { label: 'About', path: '/about' },
  { label: 'Contact', path: '/contact' },
];

// Compare against the base-stripped path so highlighting works both under the
// project Pages sub-path and at the domain root after cutover.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const current = Astro.url.pathname.replace(base, '').replace(/\/+$/, '') || '/';
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={href('/')}>
      <span class="brand__name">Bala Regatta</span>
      {/*
        Deliberately no founding year. "115th in 2026" implies 1911 only if no
        year was ever skipped, and skipped years are exactly what a century-old
        event has. Put a date here once the association confirms one.
      */}
      <span class="brand__tag">Township Dock &middot; Muskoka</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle visually-hidden" />
    <label for="nav-toggle" class="nav-toggle__label">
      <span aria-hidden="true">☰</span>
      <span class="visually-hidden">Menu</span>
    </label>

    <nav aria-label="Main">
      <ul class="nav list-plain">
        {
          nav.map((item) => {
            const isCurrent = current === item.path || current.startsWith(`${item.path}/`);
            return (
              <li>
                <a href={href(item.path)} aria-current={isCurrent ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--water-deep);
    color: #f6f2e9;
    border-bottom: 3px solid var(--pennant);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-s);
  }

  .brand {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .brand__name {
    display: block;
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .brand__tag {
    display: block;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #b9cdd6;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin: 0;
  }

  .nav a {
    color: #f6f2e9;
    text-decoration: none;
    font-weight: 500;
    padding-block: var(--space-3xs);
    border-bottom: 2px solid transparent;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    border-bottom-color: var(--pennant);
  }

  .nav-toggle__label {
    display: none;
  }

  /* Checkbox toggle keeps the mobile menu working with zero JavaScript. */
  @media (max-width: 46rem) {
    .nav-toggle__label {
      display: block;
      font-size: var(--step-2);
      cursor: pointer;
      padding: 0 var(--space-2xs);
      color: #f6f2e9;
    }

    .site-header__inner nav {
      flex-basis: 100%;
      display: none;
    }

    .nav-toggle:checked ~ nav {
      display: block;
    }

    .nav {
      flex-direction: column;
      gap: 0;
      border-top: 1px solid rgb(255 255 255 / 15%);
      padding-top: var(--space-2xs);
    }

    .nav a {
      display: block;
      padding-block: var(--space-2xs);
      border-bottom: 0;
    }
  }

  .nav-toggle:focus-visible ~ .nav-toggle__label {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>

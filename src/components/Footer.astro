---
import { href } from '../lib/url';
import { getSettings } from '../lib/settings';

const settings = await getSettings();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div>
      <p class="site-footer__name">Bala Regatta</p>
      <p class="site-footer__meta">Presented by the Bala Aquatic Association</p>
    </div>

    <nav aria-label="Footer">
      <ul class="list-plain site-footer__links">
        <li><a href={href('/')}>Home</a></li>
        <li><a href={href('/program')}>Event Program</a></li>
        <li><a href={href('/archives')}>Archives</a></li>
      </ul>
    </nav>

    <div>
      {
        settings.email && (
          <p class="site-footer__meta">
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </p>
        )
      }
      {
        (settings.facebook || settings.instagram) && (
          <p class="site-footer__meta">
            {settings.facebook && <a href={settings.facebook}>Facebook</a>}
            {settings.facebook && settings.instagram && ' · '}
            {settings.instagram && <a href={settings.instagram}>Instagram</a>}
          </p>
        )
      }
      <p class="site-footer__meta">
        <a href={href('/archives/corrections')}>Spotted an error in the archives?</a>
      </p>
    </div>
  </div>

  <div class="wrap">
    <p class="site-footer__legal">
      &copy; {year} Bala Aquatic Association. Historical material is published for the
      community record; please get in touch about any photograph or name you would like
      corrected or removed.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--bg);
    color: var(--fg);
    border-top: 3px solid var(--sky);
    padding-block: var(--space-xl) var(--space-m);
    font-size: var(--step--1);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
  }

  .site-footer__name {
    font-family: var(--serif);
    font-size: var(--step-1);
    margin: 0 0 var(--space-3xs);
    color: var(--fg);
  }

  .site-footer__meta {
    margin: 0 0 var(--space-2xs);
    color: var(--fg-muted);
    max-width: none;
  }

  .site-footer__links {
    margin: 0;
    display: grid;
    gap: var(--space-3xs);
  }

  .site-footer a {
    color: var(--accent);
  }

  .site-footer__legal {
    margin: var(--space-l) 0 0;
    padding-top: var(--space-s);
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    max-width: 70ch;
  }
</style>
